# Endpoint that receives survey requests (JSON POST). Required in production.
VITE_FORM_WEBHOOK=

# Absolute URL of the published page. Used for canonical, Open Graph and JSON-LD.
VITE_SITE_URL=https://tasleeh.net/planned-maintenance/

# Tracking. Leave empty to disable a tag; nothing loads until an ID is set.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=
# LinkedIn conversion ID for the survey lead (fires on form_submit_success).
VITE_LINKEDIN_CONVERSION_ID=

# WhatsApp Business number in international format without "+" or spaces,
# e.g. 9715XXXXXXXX. The floating WhatsApp button stays hidden while empty.
VITE_WHATSAPP_NUMBER=
